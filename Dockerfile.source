# 从源码构建本 fork 的面板镜像（含前端）。
# 构建:
#   docker build -f Dockerfile.source -t ghcr.io/yvdonghai/komari:local .
#
# 说明: CI 发布仍使用 Dockerfile + 预编译二进制（见 .github/workflows/docker-publish.yml）

FROM node:22-bookworm AS frontend
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends git zstd \
  && rm -rf /var/lib/apt/lists/*
ARG KOMARI_WEB_REPO=https://github.com/komari-monitor/komari-web.git
ARG KOMARI_WEB_REF=main
RUN git clone --depth 1 --branch "${KOMARI_WEB_REF}" "${KOMARI_WEB_REPO}" web-src
WORKDIR /src/web-src
RUN npm ci && npm run build
RUN mkdir -p /out/defaultTheme \
  && tar -cf /tmp/komari-dist.tar -C dist . \
  && zstd -19 -T0 -f /tmp/komari-dist.tar -o /out/defaultTheme/dist.tar.zst \
  && cp komari-theme.json /out/defaultTheme/komari-theme.json

FROM golang:1.25-bookworm AS backend
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev \
  && rm -rf /var/lib/apt/lists/*
COPY . .
COPY --from=frontend /out/defaultTheme ./web/public/defaultTheme
ARG VERSION=dev
ARG VERSION_HASH=unknown
ENV CGO_ENABLED=1 GIN_MODE=release
RUN go build -trimpath \
  -ldflags="-s -w -X github.com/komari-monitor/komari/utils.CurrentVersion=${VERSION} -X github.com/komari-monitor/komari/utils.VersionHash=${VERSION_HASH}" \
  -o /out/komari .

FROM alpine:3.21
WORKDIR /app
RUN apk add --no-cache ca-certificates curl tzdata
COPY --from=backend --chmod=755 /out/komari /app/komari
ENV GIN_MODE=release
ENV KOMARI_LISTEN=0.0.0.0:25774
EXPOSE 25774
VOLUME ["/app/data"]
CMD ["/app/komari", "server"]
